// Two-rotor 1.3 L rotary engine with dimensions similar to a Mazda 13B
// (e = 15 mm, R = 105 mm, 80 mm wide housings).
//
// Rotary engine scripting notes:
//  - The crankshaft is the eccentric shaft; its throw is the eccentricity
//  - Each rotor is added with add_rotor() and sits on one rod journal
//  - Housing angles (ports and spark plug) are measured counter-clockwise from
//    the minor axis on the spark plug side, which faces the crankshaft's TDC
//  - An engine cycle lasts three crankshaft revolutions and each rotor's spark
//    plug fires once per revolution

import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(3 * 360 * units.deg)

private node wires {
    output front: ignition_wire();
    output rear: ignition_wire();
}

public node two_rotor_13b {
    alias output __out: engine;

    wankel_engine engine(
        name: "Two-Rotor 1.3L",
        starter_torque: 60 * units.lb_ft,
        starter_speed: 300 * units.rpm,
        redline: 8500 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.85,
            burning_efficiency_randomness: 0.4,
            max_dilution_effect: 4.0
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.01,
        noise: 0.8,
        jitter: 0.4,
        simulation_frequency: 15000
    )

    wires wires()

    label eccentricity(15 * units.mm)
    label generating_radius(105 * units.mm)
    label housing_width(80 * units.mm)
    label rotor_mass(4.5 * units.kg)

    crankshaft eccentric_shaft(
        throw: eccentricity,
        flywheel_mass: 8 * units.lb,
        mass: 10 * units.lb,
        friction_torque: 8.0 * units.lb_ft,
        moment_of_inertia: 0.12,
        position_x: 0.0,
        position_y: 0.0,
        tdc: constants.pi / 2
    )

    // The rotors are 180 degrees apart on the eccentric shaft
    rod_journal front_lobe(angle: 0.0 * units.deg)
    rod_journal rear_lobe(angle: 180.0 * units.deg)
    eccentric_shaft
        .add_rod_journal(front_lobe)
        .add_rod_journal(rear_lobe)

    engine.add_crankshaft(eccentric_shaft)

    wankel_rotor rotor(
        mass: rotor_mass,
        moment_of_inertia: 0.5 * rotor_mass * (0.8 * generating_radius) * (0.8 * generating_radius),
        radius: generating_radius,
        crown_gear_radius: 3 * eccentricity,
        depth: housing_width,
        depression_volume: 45 * units.cc
    )

    intake intake(
        plenum_volume: 2.0 * units.L,
        plenum_cross_section_area: 10.0 * units.cm2,
        intake_flow_rate: k_carb(450.0),
        runner_flow_rate: k_carb(250.0),
        runner_length: 12.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.99,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(700.0),
        primary_tube_length: 14.0 * units.inch,
        primary_flow_rate: k_carb(400.0),
        velocity_decay: 1.0,
        volume: 8.0 * units.L
    )

    exhaust_system exhaust(
        es_params,
        audio_volume: 2.0,
        impulse_response: ir_lib.minimal_muffling_02
    )

    // A peripheral port stays open for 360 degrees of shaft rotation plus
    // three times its angular width. These narrow ports give:
    //   exhaust opens 90 deg BBDC, closes 6 deg ATDC
    //   intake opens 9 deg BTDC, closes 87 deg ABDC
    label intake_port_start(121 * units.deg)
    label intake_port_end(123 * units.deg)
    label exhaust_port_start(238 * units.deg)
    label exhaust_port_end(240 * units.deg)

    engine
        .add_rotor(
            intake: intake,
            exhaust_system: exhaust,
            rotor: rotor,
            rod_journal: front_lobe,
            ignition_wire: wires.front,
            primary_length: 4 * units.inch,
            intake_port: default_wankel_peripheral_port(
                intake_port_start, intake_port_end, k_carb(220.0)),
            exhaust_port: default_wankel_peripheral_port(
                exhaust_port_start, exhaust_port_end, k_carb(300.0)),
            intake_runner_cross_section_area: 8 * units.cm2,
            exhaust_cross_section_area: 8 * units.cm2,
            spark_plug_angle: 0 * units.deg
        )
        .add_rotor(
            intake: intake,
            exhaust_system: exhaust,
            rotor: rotor,
            rod_journal: rear_lobe,
            ignition_wire: wires.rear,
            primary_length: 4 * units.inch,
            intake_port: default_wankel_peripheral_port(
                intake_port_start, intake_port_end, k_carb(220.0)),
            exhaust_port: default_wankel_peripheral_port(
                exhaust_port_start, exhaust_port_end, k_carb(300.0)),
            intake_runner_cross_section_area: 8 * units.cm2,
            exhaust_cross_section_area: 8 * units.cm2,
            spark_plug_angle: 0 * units.deg
        )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 5 * units.deg)
        .add_sample(1000 * units.rpm, 5 * units.deg)
        .add_sample(2000 * units.rpm, 15 * units.deg)
        .add_sample(3000 * units.rpm, 20 * units.deg)
        .add_sample(4000 * units.rpm, 25 * units.deg)
        .add_sample(5000 * units.rpm, 25 * units.deg)

    // Each plug fires once per eccentric shaft revolution; the rear rotor
    // fires half a revolution after the front one
    engine.add_ignition_module(
        ignition_module(
            timing_curve: timing_curve,
            rev_limit: 9000 * units.rpm,
            limiter_duration: 0.05)
            .connect_wire(wires.front, (0.0 / 6.0) * cycle)
            .connect_wire(wires.rear, (1.0 / 6.0) * cycle)
            .connect_wire(wires.front, (2.0 / 6.0) * cycle)
            .connect_wire(wires.rear, (3.0 / 6.0) * cycle)
            .connect_wire(wires.front, (4.0 / 6.0) * cycle)
            .connect_wire(wires.rear, (5.0 / 6.0) * cycle)
    )
}

private node sports_coupe {
    alias output __out:
        vehicle(
            mass: 1300 * units.kg,
            drag_coefficient: 0.3,
            cross_sectional_area: (68 * units.inch) * (48 * units.inch),
            diff_ratio: 4.1,
            tire_radius: 12.5 * units.inch,
            rolling_resistance: 0.015 * 1300 * units.kg * 9.81
        );
}

private node sports_coupe_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 300 * units.lb_ft
        )
        .add_gear(3.48)
        .add_gear(2.02)
        .add_gear(1.39)
        .add_gear(1.00)
        .add_gear(0.72);
}

public node main {
    run(
        engine: two_rotor_13b(),
        transmission: sports_coupe_transmission(),
        vehicle: sports_coupe()
    )
}

main()
